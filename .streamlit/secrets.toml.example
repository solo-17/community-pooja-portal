# ==============================================================================
# Streamlit Cloud / Local Secrets (.streamlit/secrets.toml)
# ==============================================================================

# Google Cloud Service Account JSON (can be passed as a string or TOML table)
GOOGLE_SERVICE_ACCOUNT_JSON = '{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "..."}'

# Google Sheet Key / URL
GOOGLE_SHEET_KEY = "your_google_sheet_id_here"

# Google Calendar ID
GOOGLE_CALENDAR_ID = "primary"

# Meta WhatsApp Cloud API credentials
WHATSAPP_TOKEN = "EAAB..."
WHATSAPP_PHONE_NUMBER_ID = "100012345678901"
ADMIN_WHATSAPP_NUMBER = "919876543210"

# Festival Dates (14th Sep to 25th Sep 2026 - 12 Auspicious Days)
FESTIVAL_START_DATE = "2026-09-14"
FESTIVAL_DAYS = 12
