# ==============================================================================
# Passiflora Ganesh Festival 2026 Configuration (.env)
# ==============================================================================

# 1. Google Cloud Service Account Credentials
# Provide either the raw JSON string or the path to your credentials file:
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "your-project-id", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "festival-bot@your-project.iam.gserviceaccount.com"}
# Alternatively:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json

# 2. Google Sheets Configuration
# The ID or URL of your Google Sheet. Share edit permissions with the service account client_email!
GOOGLE_SHEET_KEY=your_google_sheet_id_here

# 3. Google Calendar Configuration
# Use 'primary' or the Calendar ID of the community shared calendar:
GOOGLE_CALENDAR_ID=your_community_calendar_id@group.calendar.google.com

# 4. Meta WhatsApp Cloud API
# Generate these from the Meta Developers Portal (WhatsApp App dashboard):
WHATSAPP_TOKEN=EAAB...your_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=100012345678901
ADMIN_WHATSAPP_NUMBER=919876543210

# 5. Festival Date Configuration (14th Sep to 25th Sep 2026 - 12 Auspicious Days)
FESTIVAL_START_DATE=2026-09-14
FESTIVAL_DAYS=12

# Optional: Set to 'true' to force mock mode even if credentials exist
MOCK_MODE=false
